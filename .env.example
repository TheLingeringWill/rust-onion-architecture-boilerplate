# Server configuration
HOST="127.0.0.1"
PORT=8000

# Database configuration
DATABASE_PROVIDER="postgres"
DATABASE_USER="foo"
DATABASE_PASSWORD="root"
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="5432"
DATABASE_NAME="foo"
DATABASE_URL="${DATABASE_PROVIDER}://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}"

# Aws configuration
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
AWS_REGION="eu-west-3"
AWS_ENDPOINT_URL="http://localhost:4566"
AWS_S3_BUCKET="foo-dev-upload"
AWS_SQS_QUEUE_URL="http://localhost:4566/000000000000/foo-command"

# Logger configuration
RUST_LOG=debug,tower_http=debug

# Enable documentation generation
OPENAPI_ENABLED=true
